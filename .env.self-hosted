DEPLOY_TARGET=self-hosted

# .env.self-hosted — Canonical self-hosted DEPLOY_TARGET template
#
# Copy this to .env on your deployment host and replace every changeme
# value with your real secrets.  The self-hosted target runs its own
# Postgres, owns all its keys locally, and is the reference implementation.
#
# DEPLOY_TARGET defaults to "self-hosted" when unset/empty, so this
# template also serves as the generic "I want to run the server" starting
# point.

# ── Database ──────────────────────────────────────────────────────────
# Self-hosted Postgres connection string.
DATABASE_URL=postgresql://changeme-user:changeme-pass@localhost:5432/rendure_db

# ── API auth ───────────────────────────────────────────────────────────
# Shared API key used to authenticate every /jobs and /profile request.
RENDURE_API_KEY=changeme-api-key

# ── Profile encryption ─────────────────────────────────────────────────
# 64-character hex key used to encrypt user secrets (e.g. OpenRouter key)
# stored in the local Postgres database.
# Generate with: openssl rand -hex 32
PROFILE_ENCRYPTION_KEY=<generate-with-openssl>

# ── Agent / LLM configuration ─────────────────────────────────────────
# OpenRouter API key that Python pipeline agents use to call LLMs.
OPENROUTER_API_KEY=changeme-openrouter-key

# Global default model — overridden per-agent below.
# OPENROUTER_MODEL=qwen/qwen3-8b

# Per-agent model overrides (empty = use OPENROUTER_MODEL / global fallback).
# MODEL_JOB_SCOUT=google/gemini-flash-1.5
# MODEL_RESUME_TAILOR=qwen/qwen3.5-9b
# MODEL_QUALITY_ANALYST=nvidia/nemotron-3-super-120b-a12b:free
# MODEL_CONFIRMATION=qwen/qwen3.5-9b
# MODEL_ORCHESTRATOR=qwen/qwen3.5-9b
# MODEL_FALLBACK=qwen/qwen3-8b

# ── Pipeline tuning ────────────────────────────────────────────────────
QA_PASS_THRESHOLD=0.92
MAX_TAILORING_ITERATIONS=4
AGENT_TIMEOUT_SECONDS=300
POLL_INTERVAL_SECONDS=5

# ── Jina Reader ────────────────────────────────────────────────────────
# Optional — Jina Reader works without a key on the free tier.
# JINA_API_KEY=

# ── Codex OAuth ────────────────────────────────────────────────────────
# Codex (ChatGPT OAuth) provider.  Defaults to enabled for self-hosted.
# Set to false to disable (e.g. on a shared/public host where the
# localhost callback + filesystem tokens don't work).
# CODEX_OAUTH_ENABLED=true

# ── Telegram notifications ─────────────────────────────────────────────
# Optional — set both to enable Telegram bot notifications.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
