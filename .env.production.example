# Copy to .env on the production host and replace every changeme value.

POSTGRES_USER=rendure_user
POSTGRES_PASSWORD=rendurepw@123
POSTGRES_DB=rendure_db

RENDURE_API_KEY=this_is_the_api_key
PROFILE_ENCRYPTION_KEY=91CC3417D21B4CECB294E2D5413D3FD6A211EA095D468111F25FCDFDB4A92C29

# Public host port for the frontend reverse proxy.
HTTP_PORT=80

# Agent / LLM configuration.
OPENROUTER_API_KEY=changeme-openrouter-key
OPENROUTER_MODEL=qwen/qwen3-8b
MODEL_JOB_SCOUT=
MODEL_RESUME_TAILOR=
MODEL_QUALITY_ANALYST=
MODEL_CONFIRMATION=
MODEL_ORCHESTRATOR=
