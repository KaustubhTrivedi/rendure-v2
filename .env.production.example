# Copy to .env on the production host and replace every changeme value.

POSTGRES_USER=rendure
POSTGRES_PASSWORD=changeme-generate-a-long-random-password
POSTGRES_DB=rendure

RENDURE_API_KEY=changeme-generate-a-long-random-api-key
PROFILE_ENCRYPTION_KEY=changeme-32-byte-hex-or-base64-key

# Public host port for the frontend reverse proxy.
HTTP_PORT=80

# Agent / LLM configuration.
OPENROUTER_API_KEY=changeme-openrouter-key
OPENROUTER_MODEL=qwen/qwen3-8b
MODEL_JOB_SCOUT=
MODEL_RESUME_TAILOR=
MODEL_QUALITY_ANALYST=
MODEL_CONFIRMATION=
MODEL_ORCHESTRATOR=
MODEL_FALLBACK=

QA_PASS_THRESHOLD=0.92
MAX_TAILORING_ITERATIONS=4
AGENT_TIMEOUT_SECONDS=300
POLL_INTERVAL_SECONDS=5
JINA_API_KEY=

# Optional Telegram notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
