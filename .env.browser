DEPLOY_TARGET=browser

# .env.browser — Browser-only DEPLOY_TARGET template
#
# Copy this to .env on your public demo host.  The browser target runs
# entirely on the client side — PGlite/IndexedDB replaces the server
# Postgres, the pipeline orchestrates in-browser, and LLM calls use the
# user's own OpenRouter key (BYOK).  Very little server-side config is
# needed.

# ── API auth ───────────────────────────────────────────────────────────
# The browser target still needs a server-side API key for the stateless
# scraper endpoint (POST /scrape) and any other server routes.
RENDURE_API_KEY=changeme-api-key

# ── No DATABASE_URL ────────────────────────────────────────────────────
# The browser target does NOT use a server-side database.  All data lives
# in the user's browser: PGlite (Postgres-in-WASM) on IndexedDB.  There is
# no server Postgres, no DATABASE_URL, and zero server-side data collection.
#
# Profile secrets (the user's OpenRouter key) are stored AES-encrypted in
# local PGlite and sent per-request — they never touch the server.

# ── No server OPENROUTER_API_KEY ───────────────────────────────────────
# The browser target uses bring-your-own-key: the user enters their own
# OpenRouter API key in the app.  No server-level LLM key is stored or
# needed.  The key is kept encrypted in the local PGlite database.

# ── Pipeline tuning (server-side scraper only) ─────────────────────────
# The browser target does not run the Python pipeline on the server.
# These vars affect the server-side scraper endpoint health/retry behavior.
# AGENT_TIMEOUT_SECONDS=300
# POLL_INTERVAL_SECONDS=5

# ── Jina Reader ────────────────────────────────────────────────────────
# The server-side scraper endpoint uses Jina Reader.  Free tier works
# without a key.
# JINA_API_KEY=

# ── Codex OAuth ────────────────────────────────────────────────────────
# Disabled by default in the browser target — the hosted demo is
# OpenRouter BYOK only.  The frontend VITE_CODEX_OAUTH_ENABLED flag
# hides the Codex provider in the UI.
CODEX_OAUTH_ENABLED=false

# ── Telegram notifications ─────────────────────────────────────────────
# Not applicable in the browser target — there is no server-side pipeline
# to send notifications from.  Omitted.
