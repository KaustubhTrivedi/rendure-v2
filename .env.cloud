DEPLOY_TARGET=cloud

# .env.cloud — Managed cloud DEPLOY_TARGET template
#
# Copy this to .env on your cloud host and replace every changeme value.
# The cloud target uses managed Postgres (e.g. RDS, Cloud SQL), reads
# secrets from a centralized store, and enqueues pipeline jobs to a
# worker queue instead of spawning a local subprocess.

# ── Database ──────────────────────────────────────────────────────────
# Managed cloud Postgres connection string.
DATABASE_URL=postgresql://changeme-user:changeme-pass@changeme-host:5432/rendure_db

# ── API auth ───────────────────────────────────────────────────────────
RENDURE_API_KEY=changeme-api-key

# ── Profile encryption ─────────────────────────────────────────────────
# 64-character hex key — must be the same across all cloud workers so
# encrypted profile data is portable.
# Generate with: openssl rand -hex 32
PROFILE_ENCRYPTION_KEY=<generate-with-openssl>

# ── Agent / LLM configuration ─────────────────────────────────────────
# Centralized OpenRouter key used by all cloud pipeline workers.
OPENROUTER_API_KEY=changeme-openrouter-key

# Global default model — overridden per-agent below.
# OPENROUTER_MODEL=qwen/qwen3-8b

# Per-agent model overrides (empty = use OPENROUTER_MODEL / global fallback).
# MODEL_JOB_SCOUT=google/gemini-flash-1.5
# MODEL_RESUME_TAILOR=qwen/qwen3.5-9b
# MODEL_QUALITY_ANALYST=nvidia/nemotron-3-super-120b-a12b:free
# MODEL_CONFIRMATION=qwen/qwen3.5-9b
# MODEL_ORCHESTRATOR=qwen/qwen3.5-9b
# MODEL_FALLBACK=qwen/qwen3-8b

# ── Pipeline tuning ────────────────────────────────────────────────────
QA_PASS_THRESHOLD=0.92
MAX_TAILORING_ITERATIONS=4
AGENT_TIMEOUT_SECONDS=300
POLL_INTERVAL_SECONDS=5

# ── Jina Reader ────────────────────────────────────────────────────────
# JINA_API_KEY=

# ── Telegram notifications ─────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ── Cloud-specific seam vars (Phase 9) ────────────────────────────────
# The cloud target will add worker-queue connection details, secret-store
# credentials, and other managed-service configuration in a later phase.
# Do not fabricate them here.
